# ─────────────────────────────────────────────────────────────────────────
# v2.0.0 CONFIGURATION SCHEMA
#
# Subpackage settings are addressed with the nested delimiter "__":
#     CHUNKING__*    chunking knobs
#     INGESTION__*   embedding concurrency and batch size
#     RETRIEVAL__*   top_k, reranker, hybrid
#     METADATA__*    extraction mode, taxonomy, Ollama classifier
#
# Cross-cutting settings keep their flat names (EMBED_MODEL, RAG_PROFILE,
# PDF_READER, credentials, ...).
#
# UPGRADING FROM v1.x: the pre-v2 flat names (TOP_K, CHUNK_SIZE,
# METADATA_EXTRACTION_MODE, ...) are no longer read. Startup FAILS with the
# nested replacement named if it finds one, rather than silently ignoring it.
# See docs/adr/037-architecture-v2-conformance.md for the full table.
# ─────────────────────────────────────────────────────────────────────────

# ── Providers, models and addresses ──────────────────────────────────────
# Provider, model and address settings live in omrs.jsonc, not in this file.
# Run `omrs config init` to write a commented starter omrs.jsonc in the user
# config folder. The Settings page in `omrs web` edits the same file.
# A value in this file locks its field in Settings, so this file holds no
# provider, model or address key. The shipped defaults use one llama.cpp
# router: `omrs llamacpp install` provisions it. Ollama and OpenRouter are
# opt-in providers; choose them in omrs.jsonc.

# ── Embedding norm guard ────────────────────────────────────────────────
# Dense ranking treats L2 distance as cosine similarity; that is only
# rank-equivalent when embedding vectors are unit-normalised. The guard
# enforces the contract: fail-closed at ingest (bad vectors never
# persist), warn-and-continue at query (results stay available).
# EMBEDDING__NORM_GUARD_ENABLED=true
# EMBEDDING__NORM_TOLERANCE=0.001

# ── Markdown chunking tokenizer (ADR-063) ─────────────────────────────
# Promoted packaged default (experiment 25 passed all four frozen
# gates; task 5.5). Markdown chunks are budgeted in the embedding
# tokenizer's own units, not characters. The tokenizer is a local
# Hugging Face cache artefact and is independent of the embedding
# inference provider (Ollama, llama.cpp, OpenRouter never see it).
# Cache it once:
#   hf download Qwen/Qwen3-Embedding-4B tokenizer.json \
#     --revision 5cf2132abc99cad020ac570b19d031efec650f2b
# Uncached revision: warning + legacy character-budgeted fallback.
# Opt back into the legacy path by setting both values empty.
# The tokenizer identity is the omrs.jsonc keys embedding.tokenizer_model and
# embedding.tokenizer_revision; this file does not set them.

# ── Query instruction (evidence-gated, not yet promoted) ──────────────
# Qwen3-Embedding models accept an instruction-style query prefix.
# The candidate below awaits the experiment 26 ablation; the packaged
# default stays empty until retrieval evidence promotes it.
# EMBEDDING__QUERY_INSTRUCTION=Given a user query, retrieve passages that provide relevant and accurate evidence for answering the query.

# ── Developer overrides ──────────────────────────────────────────────────
# Ollama context window in tokens (2048 to 262144, default 16384). Only needed
# when the Ollama provider is chosen in omrs.jsonc (TDR-036). An entry here
# locks it in the web page.
# OLLAMA_CONTEXT_WINDOW=16384
# Program that OMRS starts as the llama.cpp router: absolute path to a file named
# llama-server. Blank uses the build that `omrs llamacpp install` placed.
# LLAMACPP_SERVER_BINARY=/opt/homebrew/bin/llama-server

# ── User config folder (omrs.jsonc) ────────────────────────────────────
# Every setting in this file can also live in omrs.jsonc, in the folder
# $OMRS_CONFIG_DIR, else $XDG_CONFIG_HOME/omrs, else ~/.config/omrs.
# The key is the variable name in lower case, and "__" nests one level:
# RETRIEVAL__TOP_K is "top_k" inside "retrieval". Run `omrs config init`
# to write a starter file. The Settings page in the web workspace edits
# the same file, and keeps your comments.
# Order: environment, .env, omrs.jsonc, key file, default. Only the
# environment and .env lock a field in Settings. This .env is an optional
# override for development and CI. See docs/guides/configuration.md.
# Never write an API key in omrs.jsonc. Use a reference: env://NAME,
# file://~/.config/omrs/secrets/<name>.key or keychain://<provider>.

# ── OpenRouter (only needed when EMBED_PROVIDER=cloud or METADATA_LLM_PROVIDER=cloud) ─
# Install optional deps:  uv sync --extra openrouter
# Get your API key at:  https://openrouter.ai/keys
#
# OPENROUTER_API_KEY=sk-or-v1-...

# ── OpenAI-compatible server (Chat answers only: ANSWER__PROVIDER=openai_compatible) ─
# Works with OpenAI, LM Studio, vLLM, Together and similar. The Chat model comes
# from ANSWER__MODEL. The key is optional: a local server needs none.
# The web workspace can set the address and the key (Settings > Providers);
# an entry here locks the field.
#
# OPENAI_COMPATIBLE_API_KEY=

# ── Anthropic (Chat answers only: ANSWER__PROVIDER=anthropic) ──────────
# Install optional deps:  uv sync --extra anthropic
# Get your API key at:  https://console.anthropic.com/settings/keys
# The Chat model comes from ANSWER__MODEL. The web workspace can save the key
# in the system keychain; an entry here locks it.
#
# ANTHROPIC_API_KEY=sk-ant-...

# ── Vector store ────────────────────────────────────────────────────────
# Backend selection: "lancedb" (canonical base-install default, ADR-049)
# or "chroma" (supported optional extra — install with
# `uv sync --extra chroma` in a checkout, or `pip install "omrs[chroma]"`).
# Resolved through the vector-store registry at startup; an unknown name
# fails with the registered names listed. Switching backends re-ingests
# into the fresh store — no cross-backend migration is provided.
VECTOR_STORE=lancedb
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=documents

# LanceDB parent directory (VECTOR_STORE=lancedb only). Each collection
# maps to one table under this directory. Embedded/local only in v1 —
# LanceDB Cloud is out of scope.
LANCEDB_URI=./lancedb

# Chroma deployment mode: local (default, embedded) or cloud (hosted
# Chroma Cloud). Mode selection is explicit — an API key alone never
# switches storage. Embedding compute (EMBED_PROVIDER) and vector storage
# (CHROMA_MODE) are independent axes; all four combinations are valid:
#
#   full local            EMBED_PROVIDER=local  CHROMA_MODE=local
#   cloud compute/local   EMBED_PROVIDER=cloud  CHROMA_MODE=local
#   full cloud            EMBED_PROVIDER=cloud  CHROMA_MODE=cloud
#   local compute/cloud   EMBED_PROVIDER=local  CHROMA_MODE=cloud
CHROMA_MODE=local

# Chroma Cloud credentials (cloud mode only). The API key is required
# when CHROMA_MODE=cloud; tenant and database are optional and must be
# supplied together (omit both to resolve them from the key). Keep the
# key in this file only — never in defaults.yaml, logs, or results.
#CHROMA_CLOUD_API_KEY=
#CHROMA_CLOUD_TENANT=
#CHROMA_CLOUD_DATABASE=

# ── Chunking ────────────────────────────────────────────────────────────
# Sentence/Markdown splitters: tokenizer units.
CHUNKING__CHUNK_SIZE=512
CHUNKING__CHUNK_OVERLAP=100
# AST-aware CodeSplitter: lines plus a character ceiling. These do not reuse
# the sentence token settings; CHUNK_SIZE/OVERLAP remain its fallback values.
CHUNKING__CODE_CHUNK_LINES=40
CHUNKING__CODE_CHUNK_LINES_OVERLAP=15
CHUNKING__CODE_MAX_CHARS=1500

# ── Performance ─────────────────────────────────────────────────────────
INGESTION__EMBED_BATCH_SIZE=100
INGESTION__EMBED_CONCURRENCY=4
# Ingestible extension set (comma-separated, or a JSON array string).
# Default: the seven document extensions. The `codebase` profile overlays
# source extensions; this env var overrides both (env wins over profiles).
#INGESTION__INGEST_EXTENSIONS=.pdf,.docx,.pptx,.txt,.md,.html,.csv
# Remove reader markup (<u>, <div>, <img>, table styling) from PDF text before
# chunking; visible text is kept. Default on. Changing it reprocesses every
# source once (it is part of the index identity).
#INGESTION__NORMALISE_READER_OUTPUT=true

# ── Retrieval ───────────────────────────────────────────────────────────
RETRIEVAL__TOP_K=10
RETRIEVAL__RERANK_ENABLED=false
RETRIEVAL__RERANK_BACKEND=onnx
RETRIEVAL__SIMILARITY_THRESHOLD=0.0
RETRIEVAL__RERANK_FETCH_MULTIPLIER=3
RETRIEVAL__RERANK_MAX_FETCH=100

# ── Metadata extraction ──────────────────────────────────────────────────
# llamaindex: temporarily split the file, cap the node count, run LlamaIndex
# extractors, then aggregate their output back to one file-level metadata dict.
# local: per-file LLM classification (uses METADATA_LLM_PROVIDER for LLM selection)
# keyword: regex pattern matching (no LLM required)
# disabled: no metadata extraction
# Install the optional dep first: uv sync --extra metadata
#
# The model for metadata classification is the llamacpp_chat_model setting (the
# Text model) on the llama.cpp backend. Choose it in omrs.jsonc.
METADATA__EXTRACTION_MODE=llamaindex
# Exact number of temporary split nodes allowed into the expensive extractors.
# LLAMANDEX_EXTRACTOR_MAX_CHUNKS=10
# Retry budget and per-attempt timeout for metadata classification.
# These govern ALL three backends (Ollama, llama.cpp, OpenRouter), not just Ollama.
# METADATA__CLASSIFY_MAX_ATTEMPTS=3
# METADATA__CLASSIFY_TIMEOUT=30.0
# Separate budget for the llamaindex extractor pass over its capped nodes.
# Classification asks one question and may retry; merging the two budgets
# would make classification wait much longer before falling back.
# METADATA__PIPELINE_TIMEOUT=180.0
#
# Per-provider overrides for the two timeouts above. Unset (the default)
# falls back to the matching shared value; set only the machine that
# needs different tuning (e.g. a slower local box wants a longer
# pipeline budget without loosening the fast-fail classify budget).
# METADATA__LLAMACPP_CLASSIFY_TIMEOUT_OVERRIDE=30.0
# METADATA__OLLAMA_CLASSIFY_TIMEOUT_OVERRIDE=30.0
# METADATA__OPENROUTER_CLASSIFY_TIMEOUT_OVERRIDE=30.0
# METADATA__LLAMACPP_PIPELINE_TIMEOUT_OVERRIDE=180.0
# METADATA__OLLAMA_PIPELINE_TIMEOUT_OVERRIDE=180.0
# METADATA__OPENROUTER_PIPELINE_TIMEOUT_OVERRIDE=180.0

# ── Grounded answering ──────────────────────────────────────────────────
# Server-side model for `omrs answer` and the answer_documents MCP
# tool. The provider resolves through the same LLM registry as metadata
# extraction (ollama ships in the base install; llamacpp/openrouter are
# optional extras). ANSWER__MODEL overrides the provider's model so
# answering never reuses the small metadata-classification model.
# ANSWER__ENABLED=true
# ANSWER__TIMEOUT=120.0
# COMPACT may refine across several completion rounds; rounds are bounded
# (1-8, and the client-sampling path caps at 4); context_window is a
# per-round budget in characters.
# ANSWER__MAX_ROUNDS=4
# ANSWER__CONTEXT_WINDOW=8192
# ANSWER__MAX_OUTPUT_TOKENS=2048
# Prefer the MCP client's model (multi-round-trip sampling) over the
# server model when the client advertises the capability.
# ANSWER__PREFER_CLIENT_SAMPLING=true
# Allow the deprecated sampling back-channel ONLY on a negotiated
# pre-2026-07-28 legacy session (never on a modern session).
# ANSWER__ALLOW_LEGACY_SAMPLING=true
# ── Claim verification (opt-in judge, default cloud — ADR-059) ───────
# When true, every cited claim is checked by an LLM judge before the
# answer reports ok: all supported → ok + verified=true; any unsupported
# → unverified_claims (evidence retained). One judge call PER CITED CLAIM
# to a cloud model (~3.3 s P95 each on GLM-5.3, experiment 20). An
# unavailable provider degrades to verification_skipped — the answer is
# never blocked. Off by default (ADR-024 local-first).
# ANSWER__VERIFY_CLAIMS=false
# Empty derives the judge model from the provider default.
# Alias: "cloud" (or empty) → the cloud backend, "local" → the local
# backend; otherwise a literal LLM-registry name (validated at startup).

# ── Hugging Face ──────────────────────────────────────────────────
# HF_TOKEN=hf_your_token_here

# ── PDF reader list ────────────────────────────────────────────────
# Comma-separated, in order. The first installed reader reads the file.
# A later reader retries when the reader before it returned no text for a
# PDF with pages. Names: pdf_inspector, liteparse, pypdfium2, pypdf.
# This line is the packaged default. The old single-value PDF_READER key
# still works. Set only one of the two in the same file.
PDF_READERS=pdf_inspector,liteparse,pypdf
LITEPARSE_OCR_ENABLED=false

# ── OCR routing switch (page-level, ADR-069) ─────────────────────────
# OCR routing judges every page. A flagged page goes to the OCR worker.
# OCR_FALLBACK_ENABLED switches OCR routing on and off. The document-level
# thresholds OCR_FALLBACK_MIN_CONFIDENCE and OCR_FALLBACK_PAGE_FRACTION
# were removed. Setting either name fails start-up.
#
# With no worker and no local runtime, a flagged page keeps its native text
# and the batch continues with an actionable warning.
# Provision an engine first (python3 ocr-workers/provision.py <engine>) and
# set OCR_WORKERS_DIR below. Expect roughly 7-56 s per OCR'd page for
# dots-mocr on Apple Silicon MPS, and 34-106 s for PaddleOCR-VL on CPU.
# OCR_FALLBACK_ENABLED=true

# ── OCR routing unit and the local OCR tier ───────────────────────
# `page` is the default and the only legal value. OCR_ROUTING_UNIT=document
# fails start-up. The names are flat on purpose: pydantic-settings resolves
# the __ delimiter only into nested blocks, so a nested spelling such as
# OCR__ROUTING_UNIT would be discarded in silence.
# The local tier also needs the two runtime libraries below; both ship
# with base dependencies. If the local runtime is missing, flagged pages go
# to the worker. See docs/guides/ingestion.md and ADR-069.
# OCR_LOCAL_BACKENDS lists the local OCR backends in order. A change
# reindexes PDF sources once.
# OCR_LOCAL_BACKENDS=pp-ocrv6-small
# OCR_LOCAL_CUTS sets the confidence cut of a backend, as a JSON object keyed
# by backend name. A backend with no entry uses its own default cut
# (pp-ocrv6-small: 0.92, indra: 0.94). A cut change reindexes PDF sources only.
# OCR_LOCAL_CUTS={"indra": 0.96}
# OCR_LOCAL_OFFLINE=false
# OCR_LOCAL_MODEL_DIRECTORY=
# READING_PART_OPTIONS holds the options of reading parts that have no own
# keys, as JSON keyed by part name. An installed page rule runs only when its
# entry holds "enabled": true. Start-up refuses an unknown part or option.
# READING_PART_OPTIONS={"stamp-check": {"enabled": true}}
# OMRS sets the two variables below itself, from the libraries bundled in
# the running environment, when they are unset. Set them only to use
# other libraries. The values are macOS examples (Python 3.12, ONNX
# Runtime 1.28.0). Replace them with the library paths of your platform.
# PDFIUM_LIB_PATH=.venv/lib/python3.12/site-packages/liteparse/libpdfium.dylib
# ORT_DYLIB_PATH=.venv/lib/python3.12/site-packages/onnxruntime/capi/libonnxruntime.1.28.0.dylib
# PDF_INSPECTOR_MODEL_CACHE=

# ── OCR engine routes (how to reach the engines) ────────────────────
# Separate from the calibrated gate above: these say HOW to start the
# isolated OCR engines, not WHICH PDFs deserve them. OCR_ENGINES lists
# the engines in order. Every OCR dispatch goes to the first available
# engine. A later engine serves only when every engine before it is
# unavailable before dispatch. A bad answer never moves a request. With no
# engine available, OCR-required
# PDFs keep their partial pdf-inspector text and are marked degraded.
# Provision first:
#   python3 ocr-workers/provision.py dots-mocr --accept-model-licence
#   python3 ocr-workers/provision.py paddleocr-vl
# Read ocr-workers/engines/dots-mocr/LICENCE-NOTES.md before accepting.
# dots-mocr needs about 7-9 GB of MPS memory; on a small machine put
# paddleocr-vl first in OCR_ENGINES. A list of one engine means no
# fallback. An empty OCR_WORKERS_DIR makes every route unavailable.
# The old OCR_ENGINE_PRIMARY and OCR_ENGINE_FALLBACK keys still work.
# Set only one form in the same file.
# OCR_WORKERS_DIR=/absolute/path/to/repo/ocr-workers
# OCR_ENGINES=dots-mocr,paddleocr-vl
# Keep engine weights outside the worktree (engine <name> uses $VALUE/<name>/):
# OMRS_OCR_MODEL_CACHE=/absolute/path/to/ocr-models
#
# OCR_WORKER_COMMAND and OCR_WORKER_ENV_DIR were removed: start-up refuses
# them. Set OCR_WORKERS_DIR and OCR_ENGINES instead.
# The timeout for one request is max(OCR_WORKER_REQUEST_TIMEOUT,
# pages x OCR_WORKER_SECONDS_PER_PAGE).
# OCR_WORKER_REQUEST_TIMEOUT=300.0
# OCR_WORKER_SECONDS_PER_PAGE=120

# ── Maths-page routing (born-digital maths papers) ──────────────────
# A page that uses a maths font (Computer Modern, Latin Modern, AMS,
# Cambria Math, STIX ...) goes to the OCR engines, which read equations
# from the page image. Flagged pages skip the local tier. OMRS removed
# OCR_MATHS_PAGE_FRACTION; setting it fails start-up.
# OCR_MATHS_ROUTING_ENABLED=true
# ── Non-Latin page routing ──────────────────────────────────────────
# off (default), detect or always. detect sends a flagged page whose text layer
# is mostly non-Latin letters straight to the OCR engines, and escalates a
# non-Latin local OCR result whatever its confidence. detect cannot see a
# scanned page (no text layer). always sends every flagged page straight to
# the engines, for a collection you know is non-Latin. Any other value fails
# start-up.
# OCR_NON_LATIN_ROUTING=off

# ── Codebase map: Magika file-type detection ────────────────────────
# MAGIKA_BINARY=magika
# DOC_SIMILARITY_THRESHOLD=0.85
# CODEBASE_MAP_CACHE_DIR=.opencode
# CODEBASE_MAP_MAX_FILES=5000
# CODEBASE_MAP_MAX_DEPTH=10

# ── Community detection (codebase + document graphs) ────────────────
# louvain = base install (default). leiden = optional extra:
#   uv sync --extra community-leiden
# Selecting leiden without the extra fails startup (no fallback to louvain).
# COMMUNITY_ALGORITHM=louvain
# Seed controls algorithm randomness; 0 (default) keeps partitions deterministic.
# COMMUNITY_SEED=0

# ── Document backend selection ──────────────────────────────────────
# Accepted values: local (default) or azure. Unknown values fail startup.
# azure = optional extra: uv sync --extra azure
# Without credentials or the extra, azure degrades to local with a warning.
DOCUMENT_BACKEND=local
# AZURE_DOC_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# AZURE_DOC_INTELLIGENCE_KEY=

# ── omrs web (local web workspace) ──────────────────────────────────
# Per-file upload limit in MiB, 1 to 2048. --max-upload-mib wins over it.
# It wins over "web_max_upload_mib" in omrs.jsonc and locks that limit for
# the run. Without it, the value in omrs.jsonc applies, else 50.
# WEB_MAX_UPLOAD_MIB=50
